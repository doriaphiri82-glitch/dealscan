# DealScan production environment
#
# Vercel: add these in Project Settings -> Environment Variables.
# The pipeline uses the same variables in GitHub Actions.

# OpenAI — keep the real value out of Git and client-side code
OPENAI_API_KEY=
OPENAI_DEAL_MODEL=gpt-5.6-luna
OPENAI_AI_SCORE_THRESHOLD=70

# Preferred: Upstash Redis REST endpoint + token
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional alternative: native Redis or Upstash Redis URL
REDIS_URL=
