# DealScan production environment
#
# Vercel: add the NEXT_PUBLIC_* variables in Project Settings -> Environment Variables.
# GitHub Actions: add SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as repository secrets.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to Vercel/browser/client code.

# Supabase — public web client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side ingestion only (GitHub Actions / backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_TIMEOUT=30

# Optional: Upstash Redis REST endpoint + token for low-latency published bundle cache
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional alternative: native Redis or Upstash Redis URL
REDIS_URL=
REDIS_TOKEN=
UPSTASH_REDIS_REST_TOKEN=

# Optional AI/source enrichment credentials used by pipeline modules
OPENAI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Optional email delivery
EMAIL_API_KEY=
