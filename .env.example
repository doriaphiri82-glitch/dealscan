# Local development example. Never store real keys in Git or chat.
# Production requires both DEALSCAN_ENV=production and DEALSCAN_DB_BACKEND=supabase.
DEALSCAN_ENV=development
DEALSCAN_DB_BACKEND=sqlite
# Optional absolute path for an isolated local database / runtime registry.
DEALSCAN_SQLITE_PATH=
DEALSCAN_REGISTRY_PATH=data/counties.json

# Browser-safe Supabase configuration (Vercel root: landing, Node 22).
# Use only an anon JWT or a modern sb_publishable_ key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private server-only credentials for ingestion/admin/waitlist.
# Allowed in protected GitHub/Vercel server environments, NEVER NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_TIMEOUT=30
# Separate public key for production smoke/RLS checks, never a service key.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
PRODUCTION_APP_URL=

# A real public operator contact is required before signup collection is enabled.
WAITLIST_CONTACT_EMAIL=

# Optional research credentials do not authorize ingestion.
OPENAI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Optional diagnostics / email helpers. Not public API fallback or publication.
ENABLE_CACHE_EXPORT=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=
REDIS_TOKEN=
ENABLE_EMAIL_DELIVERY=false
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
