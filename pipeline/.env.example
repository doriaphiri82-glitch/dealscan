# DealScan AI - Environment Configuration
# Copy this file to .env and fill in your values

# Email Provider: 'console' (for testing), 'resend', or 'sendgrid'
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=deals@dealscan.ai

# Resend API Key (get at https://resend.com)
# RESEND_API_KEY=re_xxxxx

# SendGrid API Key (get at https://sendgrid.com)
# SENDGRID_API_KEY=SG.xxxxx

# Whop API (for store integration)
# WHOP_API_KEY=

# Discord Webhook (for community deal alerts)
# DISCORD_WEBHOOK_URL=
