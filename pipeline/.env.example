# Python 3.11. Keep real environment files out of Git and chat.
DEALSCAN_ENV=development
DEALSCAN_DB_BACKEND=sqlite
DEALSCAN_SQLITE_PATH=
DEALSCAN_REGISTRY_PATH=data/counties.json

# Production must explicitly switch both environment/backend above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_TIMEOUT=30
# A different, public key for independent production smoke RLS checks.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
PRODUCTION_APP_URL=

# Optional source research, never authorization.
OPENAI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Optional utilities stay disabled; CLI email delivery is not shipped.
ENABLE_EMAIL_DELIVERY=false
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
ENABLE_CACHE_EXPORT=false
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=
REDIS_TOKEN=
