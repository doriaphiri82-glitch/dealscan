# Copy to .env.local for local development; never commit real keys.
# Vercel project root must be landing. Use Node 22 and npm ci.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon JWT or sb_publishable_ key only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin/consented-signup operations. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Real operator contact shown on /privacy; collection is disabled if absent.
WAITLIST_CONTACT_EMAIL=
