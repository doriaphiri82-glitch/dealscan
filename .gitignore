*.db
*.sqlite
*.sqlite3
*.log

# ===== Environment & secrets =====
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*

# ===== Pipeline (Python) =====
venv/
.venv/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# ===== OS / editor =====
.DS_Store
Thumbs.db
*.swp
.idea/
.vercel

# ===== Local engineering reports and test scratch files =====
.arena/

