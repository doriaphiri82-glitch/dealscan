# ===== Landing (Next.js webapp) =====
landing/node_modules/
landing/.next/
landing/out/
*.tsbuildinfo
landing/next-env.d.ts

# ===== Private runtime files and generated snapshots (never commit source rows) =====
landing/data/*
data/*
pipeline/data/*
